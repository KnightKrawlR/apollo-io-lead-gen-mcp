{
  "version": 2,
  "builds": [
    {
      "src": "api/mcp.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/mcp-stateless.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/mcp-stateless",
      "dest": "/api/mcp-stateless.ts"
    },
    {
      "src": "/mcp",
      "dest": "/api/mcp.ts"
    }
  ]
}
